ENVIRONMENT=development
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
AI_MODEL_PROVIDER=deterministic
AI_MODEL_API_KEY=
AI_MODEL_NAME=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Chat can inherit the scanner provider, or use Groq independently so a
# low-cost text model never changes the vision scanner configuration.
CHAT_MODEL_PROVIDER=inherit
CHAT_MODEL_API_KEY=
CHAT_MODEL_NAME=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=45
AI_WEB_SEARCH_ENABLED=false
AI_ALLOWED_DOMAINS=
MAX_IMAGE_UPLOAD_MB=5
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=keikoocatalasan@gmail.com
