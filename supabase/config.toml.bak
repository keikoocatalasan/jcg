[project]
name = "jcg-fitness"
region = "ap-southeast-1"

[auth]
enabled = true
site_url = "http://localhost:3000"
additional_redirect_urls = []
jwt_expiry = 3600
enable_signup = true

[auth.email]
enable_confirmations = false
enable_autoconfirm = true

[api]
enabled = true
port = 54321
schemas = ["public", "storage", "graphql_public"]

[db]
port = 54322
migration_dir = "supabase/migrations"
seed_file = "supabase/seed.sql"

[storage]
enabled = false

[realtime]
enabled = false

[studio]
enabled = true
port = 54323

[inbucket]
enabled = false

[webhooks]
enabled = false
